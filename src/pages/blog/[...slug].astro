---
/**
 * Legacy URL compatibility route.
 *
 * The old Gatsby site served posts at URL shapes like:
 *   /blog/2020/06/08/godaddy-with-github.io
 *   /blog/2020-06-04/gatsby-plugins
 *   /blog/2020/06/23/python-Classes에-대해-알아보자
 *
 * Every migrated post carries its original path in `legacyUrl`, so we can
 * reproduce it here and keep inbound links and search results alive.
 */
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "@/pages/posts/[...slug]/_components/EditPost.astro";
import ShareLinks from "@/pages/posts/[...slug]/_components/ShareLinks.astro";
import BackButton from "@/pages/posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "@/pages/posts/[...slug]/_components/BackToTopButton.astro";
import AdjacentPostNav from "@/pages/posts/[...slug]/_components/AdjacentPostNav.astro";
import PostToc from "@/pages/posts/[...slug]/_components/PostToc.astro";
import config from "@/config";

export async function getStaticPaths() {
  const LEGACY_PREFIX = "/blog/";
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts
    .map((post, index) => {
      const legacyUrl = post.data.legacyUrl;
      if (!legacyUrl || !legacyUrl.startsWith(LEGACY_PREFIX)) return null;

      const legacySlug = legacyUrl.slice(LEGACY_PREFIX.length).replace(/\/+$/, "");
      if (!legacySlug) return null;

      return {
        params: { slug: legacySlug },
        props: {
          post,
          canonicalPath: legacyUrl,
          prevPost:
            index < sortedPosts.length - 1
              ? {
                  id: sortedPosts[index + 1].id,
                  title: sortedPosts[index + 1].data.title,
                  filePath: sortedPosts[index + 1].filePath,
                }
              : null,
          nextPost:
            index > 0
              ? {
                  id: sortedPosts[index - 1].id,
                  title: sortedPosts[index - 1].data.title,
                  filePath: sortedPosts[index - 1].filePath,
                }
              : null,
        },
      };
    })
    .filter(Boolean);
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  canonicalPath: string;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, canonicalPath, prevPost, nextPost } = Astro.props;

const {
  title,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
  hideToc,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = config.features.toc && !hideToc ? headings : [];

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalPath}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(post.id) }}
      class="inline-block text-2xl font-bold"
      id="main-content-skip"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center justify-between">
      <Datetime
        pubDatetime={pubDatetime}
        modDatetime={modDatetime}
        size="sm"
        class="my-2"
      />
      <EditPost post={post} hideEditPost={hideEditPost} />
    </div>

    {
      tags && Array.isArray(tags) && tags.length > 0 && (
        <ul class="mb-4 flex flex-wrap gap-2">
          {tags.map(tag => (
            <li class="inline-block">
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            </li>
          ))}
        </ul>
      )
    }

    {tocHeadings.length > 0 && <PostToc headings={tocHeadings} />}

    <article id="article" role="presentation" class="app-prose mb-8 max-w-none">
      <Content />
    </article>

    {config.features.showBackButton && <BackToTopButton />}

    <ShareLinks title={title} />
    <AdjacentPostNav prevPost={prevPost} nextPost={nextPost} />
  </main>

  <Footer />
</PostLayout>
