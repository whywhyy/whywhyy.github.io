---
/**
 * Legacy URL compatibility route.
 *
 * The old Gatsby site served posts at paths like
 *   /blog/2020/06/08/godaddy-with-github.io
 *   /blog/2020-06-04/gatsby-plugins
 *
 * Each migrated post carries its original address in `legacyUrl`, reproduced
 * here so inbound links and search results keep working.
 */
import { getCollection } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import PostArticle from "@/components/PostArticle.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

/** Old Gatsby posts all lived under /blog/. */
export async function getStaticPaths() {
  const prefix = "/blog/";
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts
    .map((post, index) => {
      const legacyUrl = post.data.legacyUrl;
      if (!legacyUrl?.startsWith(prefix)) return null;

      const slug = legacyUrl
        .slice(prefix.length)
        .replace(/\/+$/, "");
      if (!slug) return null;

      return {
        params: { slug },
        props: {
          post,
          canonicalPath: legacyUrl,
          prevPost:
            index < sortedPosts.length - 1
              ? {
                  id: sortedPosts[index + 1].id,
                  title: sortedPosts[index + 1].data.title,
                  filePath: sortedPosts[index + 1].filePath,
                }
              : null,
          nextPost:
            index > 0
              ? {
                  id: sortedPosts[index - 1].id,
                  title: sortedPosts[index - 1].data.title,
                  filePath: sortedPosts[index - 1].filePath,
                }
              : null,
        },
      };
    })
    .filter(Boolean);
}

const { post, canonicalPath, prevPost, nextPost } = Astro.props;
const { title, description, ogImage, pubDatetime, modDatetime } = post.data;

const ogImageUrl =
  typeof ogImage === "string" ? ogImage : ogImage?.src ?? undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImageUrl}
  canonicalURL={canonicalPath}
  {pubDatetime}
  {modDatetime}
>
  <PostArticle {post} {prevPost} {nextPost} />
</PostLayout>
